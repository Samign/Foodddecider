diff --git a/nginx.conf b/nginx.conf
index d112341..e86b98f 100644
--- a/nginx.conf
+++ b/nginx.conf
@@ -6,6 +6,36 @@ server {
     root /var/www/html;
     index index.php index.html;
 
+    client_max_body_size 10m;   # photo uploads (upload_image.php accepts up to 8 MB)
+
+    # ── Security headers ──────────────────────────────────────────────
+    # The CSP is the safety net if an XSS bug ever slips through: scripts only from this site
+    # (no inline <script>, no onclick=...), fonts from Google, everything else from this site.
+    # NOTE: nginx drops these in any location that has its own add_header, see /uploads/ below.
+    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
+    add_header X-Content-Type-Options "nosniff" always;
+    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
+    add_header X-Frame-Options "SAMEORIGIN" always;
+
+    # ── Uploaded pictures ─────────────────────────────────────────────
+    # File names change whenever a picture changes, so they can be cached for a long time.
+    # Nothing in here is ever run as PHP, and SVG avatars can't run scripts.
+    location ^~ /uploads/ {
+        location ~ \.php$ { deny all; }
+        expires 30d;
+        add_header Cache-Control "public" always;
+        add_header X-Content-Type-Options "nosniff" always;
+        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox" always;
+        try_files $uri =404;
+    }
+
+    location ^~ /assets/ {
+        expires 1h;
+        add_header Cache-Control "public" always;
+        add_header X-Content-Type-Options "nosniff" always;
+        try_files $uri =404;
+    }
+
     # A. Clean Route: /user/username -> user.php?username=username
     location ~ ^/user/([^/]+)$ {
         try_files /user.php =404;
@@ -43,13 +73,10 @@ server {
         fastcgi_param PATH_INFO $fastcgi_path_info;
     }
 
